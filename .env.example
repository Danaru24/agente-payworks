# Copia a .env para desarrollo local. TODO(ulises) = valor pendiente.
LLM_BASE_URL=http://localhost:8000/v1          # TODO(ulises)
LLM_MODEL=qwen2.5-7b-instruct                  # TODO(ulises)
LLM_MAX_MODEL_LEN=32768
EMB_BASE_URL=http://localhost:8001/v1          # TODO(ulises)
EMB_MODEL=text-embedding                       # TODO(ulises)
PG_DSN_RAG=postgresql://lector:pass@localhost:5432/payworks       # TODO(ulises)
PG_DSN_CATALOGO=postgresql://lector:pass@localhost:5432/payworks  # TODO(ulises)
PG_DSN_MEMORIA=postgresql://memoria:pass@localhost:5432/payworks  # TODO(ulises)
PG_POOL_TIMEOUT_S=5                            # espera máx. por conexión a la memoria
RAG_TABLA=payworks_rag_1024
RAG_COL_ID=id
RAG_COL_CONTENIDO=contenido
RAG_COL_METADATA=metadata
RAG_COL_EMBEDDING=embedding
RAG_EXPERIMENTO_ID=                            # opcional: filtra por experimento_id si se define
RAG_UMBRAL=0.75
CATALOGO_TABLA=paneles_dashboard               # TODO(ulises)
CATALOGO_COL_UID=panel_uid                     # TODO(ulises)
MCP_GRAFANA_URL=http://localhost:8002/mcp      # TODO(ulises)
MCP_GRAFANA_TOKEN=
GRAFANA_DASHBOARD_UID=                         # TODO(ulises)
GRAFANA_DATASOURCE_UID=                        # opcional: fallback si el panel/catálogo no trae datasourceUid
MCP_TOOLS_PERMITIDAS=get_dashboard_panel_queries,query_prometheus,generate_deeplink,get_panel_image,list_datasources
MODO_GRAFICAS=ambos                            # deeplink | png | ambos
HISTORY_WINDOW=10
MAX_INTENTOS=3
# Observabilidad (exploración)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-payworks
